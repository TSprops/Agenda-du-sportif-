rules_version = '2';

// Règles de sécurité de L'agenda du sportif.
// - Chaque utilisateur lit et écrit ses propres données (users/{uid}/...).
// - Les amis acceptés voient les séances de l'autre (s'il partage) et peuvent s'écrire.
// - Les administrateurs (document admins/{uid}, créé à la main dans la console) lisent tout.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function isSelf(uid) { return signedIn() && me() == uid; }
    // Utilisateur suspendu par l'administrateur : il ne peut plus rien publier côté social.
    function banned() { return exists(/databases/$(database)/documents/bans/$(me())); }
    function pairKey(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function isFriend(uid) {
      let path = /databases/$(database)/documents/friends/$(pairKey(me(), uid));
      return signedIn() && me() != uid && exists(path) && get(path).data.status == 'accepted';
    }
    function sharesSessions(uid) {
      let path = /databases/$(database)/documents/share/$(uid);
      return exists(path) && get(path).data.sessions == true;
    }
    function chatOk(pid) {
      let path = /databases/$(database)/documents/friends/$(pid);
      return signedIn() && exists(path) && get(path).data.status == 'accepted' && me() in get(path).data.users;
    }

    match /bans/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list, write: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid) && request.resource.data.pseudo is string
                            && request.resource.data.pseudo.size() > 0
                            && request.resource.data.pseudo.size() <= 30;
      allow delete: if isSelf(uid);

      // séances, nutrition, photos
      match /{collectionName}/{docId} {
        allow read: if isSelf(uid) || isAdmin()
                    || (collectionName == 'seances' && isFriend(uid) && sharesSessions(uid));
        allow write: if isSelf(uid)
                     && collectionName in ['seances', 'nutrition', 'photos'];
      }
    }

    // Annuaire : pseudo, code ami et photo, pour pouvoir se trouver.
    match /directory/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow write: if isSelf(uid) && !banned() && request.resource.data.uid == uid
                   && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 30
                   && request.resource.data.code is string && request.resource.data.code.size() <= 12;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Ce que les amis peuvent voir : records, statistiques, partage des séances.
    match /share/{uid} {
      allow read: if isSelf(uid) || isFriend(uid) || isAdmin();
      allow write: if isSelf(uid);
    }

    // Demandes d'ami, amitiés et blocages. L'identifiant est « uidA_uidB » (ordre alphabétique).
    match /friends/{pid} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create: if signedIn() && !banned()
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] < request.resource.data.users[1]
                    && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
                    && me() in request.resource.data.users
                    && request.resource.data.from == me()
                    && request.resource.data.to in request.resource.data.users
                    && request.resource.data.to != me()
                    && (request.resource.data.status == 'pending'
                        || (request.resource.data.status == 'blocked' && request.resource.data.blockedBy == me()));
      allow update: if signedIn() && me() in resource.data.users && (
                      // accepter une demande reçue
                      (resource.data.status == 'pending' && resource.data.to == me()
                        && request.resource.data.status == 'accepted'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']))
                      // bloquer quelqu'un
                      || (resource.data.status != 'blocked' && request.resource.data.status == 'blocked'
                        && request.resource.data.blockedBy == me()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy', 'blockedAt'])));
      allow delete: if signedIn() && me() in resource.data.users
                    && (resource.data.status != 'blocked' || resource.data.blockedBy == me());
    }

    // Conversations privées entre amis.
    match /chats/{pid} {
      allow read: if chatOk(pid);
      allow create, update: if chatOk(pid) && !banned() && me() in request.resource.data.users;
      match /messages/{mid} {
        allow read: if chatOk(pid);
        allow create: if chatOk(pid) && !banned() && request.resource.data.from == me()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Réactions des amis sur les séances : reacts/{propriétaire}/items/{date__ami}
    match /reacts/{owner}/items/{rid} {
      allow read: if isSelf(owner) || isFriend(owner);
      allow create: if isFriend(owner) && !banned() && request.resource.data.from == me()
                    && rid == request.resource.data.date + '__' + me()
                    && request.resource.data.emoji in ['muscle', 'fire', 'clap'];
      allow update: if isFriend(owner) && resource.data.from == me() && request.resource.data.from == me()
                    && request.resource.data.emoji in ['muscle', 'fire', 'clap'];
      allow delete: if signedIn() && (resource.data.from == me() || isSelf(owner));
    }

    // Commentaires des amis sur les séances : comments/{propriétaire}/items/{id}
    match /comments/{owner}/items/{cid} {
      allow read: if isSelf(owner) || isFriend(owner);
      allow create: if (isSelf(owner) || isFriend(owner)) && !banned() && request.resource.data.from == me()
                    && request.resource.data.date is string && request.resource.data.date.size() <= 14
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == me() || isSelf(owner) || isAdmin());
    }

    // Défis entre amis : chacun ne peut modifier que son propre score, ou quitter le défi.
    match /challenges/{cid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && !banned() && request.resource.data.owner == me()
                    && me() in request.resource.data.members
                    && request.resource.data.members.size() <= 20
                    && request.resource.data.name is string && request.resource.data.name.size() <= 60
                    && request.resource.data.metric in ['seances', 'jours', 'km', 'volume'];
      allow update: if signedIn() && me() in resource.data.members && (
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores'])
                        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([me()]))
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members == resource.data.members.removeAll([me()])));
      allow delete: if signedIn() && (resource.data.owner == me() || isAdmin());
    }

    // Signalements (lus par l'administrateur).
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.from == me()
                    && request.resource.data.text is string && request.resource.data.text.size() <= 1200;
      allow read, delete: if isAdmin();
    }

    // Messages de la page Contact.
    match /messages/{messageId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.lu == false
                    && request.resource.data.objet is string
                    && request.resource.data.objet.size() > 0
                    && request.resource.data.objet.size() <= 40
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() > 0
                    && request.resource.data.texte.size() <= 3000;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
